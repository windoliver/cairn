{
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/prelude/status.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "aggregate extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.aggregate.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.aggregate"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.aggregate"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.aggregate.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    },
    {
      "$comment": "admin extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.admin.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.admin"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.admin"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.admin.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    },
    {
      "$comment": "federation extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.federation.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.federation"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.federation"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.federation.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    },
    {
      "$comment": "sessiontree extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.sessiontree.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.sessiontree"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.sessiontree"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.sessiontree.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    },
    {
      "$comment": "coord extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.coord.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.coord"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.coord"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.coord.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    }
  ],
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "../capabilities/capabilities.json"
      },
      "type": "array",
      "uniqueItems": true
    },
    "contract": {
      "const": "cairn.mcp.v1"
    },
    "extensions": {
      "items": {
        "$ref": "../extensions/registry.json#/$defs/namespace"
      },
      "type": "array",
      "uniqueItems": true
    },
    "mcp_graph_tools": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "minLength": 1,
          "type": "string"
        },
        "probe_basis": {
          "enum": [
            "full",
            "config_only"
          ],
          "type": "string"
        },
        "reason": {
          "enum": [
            "single_tenant_off",
            "no_store_capability",
            "no_scope_resolver",
            "store_open_error",
            "vault_not_bound",
            "resolver_empty"
          ],
          "type": "string"
        },
        "state": {
          "enum": [
            "available",
            "unavailable",
            "probe_failed",
            "no_vault"
          ],
          "type": "string"
        },
        "tool_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "state",
        "probe_basis"
      ],
      "type": "object"
    },
    "pipeline_dispatch": {
      "description": "Per-(source_family, tool_id) routing decisions for the Capture → Extract pipeline (issue #217). Each entry tells clients whether captured payloads flow through `squash` (lossy compaction) or `bypass` (raw bytes). Entries MUST be sorted lexicographically by (source_family, tool_id ?? \"\") for byte-stable status responses across an incarnation (brief §8.0.a). Optional and additive — not in `required[]` so a pre-#217 server's response (no field) deserializes against this schema.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "description": "P0 routing enum — closed. 'squash_when_interactive_tty' admits InteractiveTty Terminal payloads to `squash`; everything else (including non-interactive Terminal) bypasses. Adding values is a wire-contract change (cairn.mcp.v1 → vNext), not an additive update — older clients' generated deserializers will reject unknown values.",
            "enum": [
              "squash_when_interactive_tty",
              "bypass"
            ],
            "type": "string"
          },
          "source_family": {
            "description": "Wire-form SourceFamily tag (matches CapturePayload variant).",
            "enum": [
              "hook",
              "ide",
              "terminal",
              "clipboard",
              "voice",
              "screen",
              "recording_batch",
              "cli",
              "mcp",
              "proactive"
            ],
            "type": "string"
          },
          "tool_id": {
            "description": "Optional tool identifier (e.g., 'Bash', 'Read'). Absent means the decision applies to every tool in this source_family — the P0 default.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_family",
          "decision"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sensors": {
      "additionalProperties": false,
      "properties": {
        "local": {
          "description": "Per-local-sensor config, consent, and gate state. Optional and additive for issue #88.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "budget": {
                "additionalProperties": false,
                "properties": {
                  "max_bytes": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "max_items": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "consent": {
                "enum": [
                  "enabled",
                  "disabled",
                  "missing"
                ],
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "gate": {
                "enum": [
                  "allowed",
                  "disabled",
                  "privacy_denied",
                  "budget_exceeded"
                ],
                "type": "string"
              },
              "last_drop_reason": {
                "enum": [
                  "disabled",
                  "privacy_denied",
                  "budget_exceeded",
                  "policy_rejected",
                  "malformed_observation"
                ],
                "type": "string"
              },
              "retention": {
                "additionalProperties": false,
                "properties": {
                  "max_days": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "sensor": {
                "enum": [
                  "hook",
                  "ide",
                  "terminal",
                  "clipboard",
                  "voice",
                  "screen",
                  "recording"
                ],
                "type": "string"
              }
            },
            "required": [
              "sensor",
              "enabled",
              "consent",
              "gate",
              "budget",
              "retention"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "screen": {
          "additionalProperties": false,
          "properties": {
            "backend": {
              "enum": [
                "xcap",
                "screenpipe"
              ],
              "type": "string"
            },
            "degradation": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "screen.disabled",
                    "screen.permission_missing",
                    "screen.backend_unavailable",
                    "screen.degraded"
                  ],
                  "type": "string"
                },
                "message": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            "mode": {
              "enum": [
                "off",
                "snapshot",
                "continuous"
              ],
              "type": "string"
            },
            "ocr_engine": {
              "enum": [
                "vision",
                "winrt",
                "tesseract",
                "off"
              ],
              "type": "string"
            },
            "permission": {
              "enum": [
                "not_requested",
                "granted",
                "denied",
                "revoked"
              ],
              "type": "string"
            },
            "state": {
              "enum": [
                "disabled",
                "permission_missing",
                "degraded",
                "enabled"
              ],
              "type": "string"
            }
          },
          "required": [
            "backend",
            "state",
            "mode",
            "ocr_engine",
            "permission"
          ],
          "type": "object"
        }
      },
      "required": [
        "screen"
      ],
      "type": "object"
    },
    "server_info": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "minLength": 1,
          "type": "string"
        },
        "incarnation": {
          "allOf": [
            {
              "$ref": "../common/primitives.json#/$defs/Ulid"
            }
          ],
          "description": "ULID minted at daemon start."
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "build",
        "started_at",
        "incarnation"
      ],
      "type": "object"
    },
    "workflows": {
      "description": "Runtime workflow-drainer progress for `cairn.admin.v1` status (issue #291). Each entry reports one workflow class; entries are sorted by workflow name for byte-stable status responses.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "drained_plans": {
            "description": "Plans drained successfully, including idempotent already-applied plans.",
            "minimum": 0,
            "type": "integer"
          },
          "last_applied_at": {
            "description": "Most recent successful plan-drain timestamp for this workflow.",
            "format": "date-time",
            "type": "string"
          },
          "pending_plans": {
            "description": "Plans produced but not yet drained, usually because cancellation stopped between plans.",
            "minimum": 0,
            "type": "integer"
          },
          "workflow": {
            "description": "Stable workflow class name.",
            "enum": [
              "consolidate",
              "promote",
              "expire"
            ],
            "type": "string"
          }
        },
        "required": [
          "workflow",
          "drained_plans",
          "pending_plans"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "contract",
    "server_info",
    "capabilities",
    "extensions",
    "sensors"
  ],
  "title": "Cairn status response",
  "type": "object",
  "x-cairn-contract": "cairn.mcp.v1"
}
