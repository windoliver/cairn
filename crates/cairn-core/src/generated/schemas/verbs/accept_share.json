{
  "$defs": {
    "Args": {
      "additionalProperties": false,
      "properties": {
        "envelope": {
          "$ref": "#/$defs/FederationEnvelope"
        }
      },
      "required": [
        "envelope"
      ],
      "type": "object"
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "applied_records": {
          "items": {
            "$ref": "../common/primitives.json#/$defs/Ulid"
          },
          "type": "array"
        },
        "outcome": {
          "enum": [
            "accepted",
            "duplicate"
          ],
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "applied_records"
      ],
      "type": "object"
    },
    "FederationEnvelope": {
      "additionalProperties": false,
      "description": "Transport envelope for federation operations. Carries either a share proposal or a revocation (brief §12.a).",
      "properties": {
        "issuer_key_id": {
          "$ref": "../common/primitives.json#/$defs/Identity"
        },
        "kind": {
          "enum": [
            "propose",
            "revoke"
          ],
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/SignedShareLink"
        },
        "manifest": {
          "items": {
            "$ref": "#/$defs/MemoryRecordStub"
          },
          "type": "array"
        },
        "revocation": {
          "$ref": "#/$defs/SignedRevocation"
        }
      },
      "required": [
        "kind",
        "issuer_key_id"
      ],
      "type": "object"
    },
    "MemoryRecordStub": {
      "additionalProperties": false,
      "description": "Minimal wire representation of a memory record included in a federation envelope manifest (brief §12.a).",
      "properties": {
        "body": {
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "record_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        },
        "scope": {
          "$ref": "#/$defs/ScopeTuple"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "visibility": {
          "enum": [
            "private",
            "session",
            "project",
            "team",
            "org",
            "public"
          ],
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "scope",
        "visibility"
      ],
      "type": "object"
    },
    "ScopeTuple": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "tenant"
          ]
        },
        {
          "required": [
            "workspace"
          ]
        },
        {
          "required": [
            "project"
          ]
        },
        {
          "required": [
            "session_id"
          ]
        },
        {
          "required": [
            "entity"
          ]
        },
        {
          "required": [
            "user"
          ]
        },
        {
          "required": [
            "agent"
          ]
        }
      ],
      "description": "Seven-dimensional scope tuple (brief §6). At least one field must be set.",
      "properties": {
        "agent": {
          "minLength": 1,
          "type": "string"
        },
        "entity": {
          "minLength": 1,
          "type": "string"
        },
        "project": {
          "minLength": 1,
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "type": "string"
        },
        "user": {
          "minLength": 1,
          "type": "string"
        },
        "workspace": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "ShareLinkPayload": {
      "additionalProperties": false,
      "description": "Body-free payload for a signed share-link grant (brief §12.a).",
      "properties": {
        "expires_at": {
          "format": "date-time",
          "minLength": 20,
          "type": "string"
        },
        "grant_tier": {
          "enum": [
            "session",
            "project",
            "team",
            "org",
            "public"
          ],
          "type": "string"
        },
        "grantee": {
          "$ref": "../common/primitives.json#/$defs/Identity"
        },
        "issued_at": {
          "format": "date-time",
          "minLength": 20,
          "type": "string"
        },
        "issuer": {
          "$ref": "../common/primitives.json#/$defs/Identity"
        },
        "key_version": {
          "minimum": 1,
          "type": "integer"
        },
        "nonce": {
          "$ref": "../common/primitives.json#/$defs/Nonce16Base64"
        },
        "operation_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        },
        "scope": {
          "$ref": "#/$defs/ScopeTuple"
        },
        "target_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "target_id_hashes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "operation_id",
        "nonce",
        "target_hash",
        "target_id_hashes",
        "scope",
        "grant_tier",
        "issuer",
        "issued_at",
        "expires_at",
        "key_version"
      ],
      "type": "object"
    },
    "SignedRevocation": {
      "additionalProperties": false,
      "description": "Signed revocation record cancelling a previously issued share link (brief §12.a).",
      "properties": {
        "issuer": {
          "$ref": "../common/primitives.json#/$defs/Identity"
        },
        "key_version": {
          "minimum": 1,
          "type": "integer"
        },
        "link_id": {
          "minLength": 1,
          "type": "string"
        },
        "revoked_at": {
          "format": "date-time",
          "minLength": 20,
          "type": "string"
        },
        "signature": {
          "$ref": "../common/primitives.json#/$defs/Ed25519Signature"
        }
      },
      "required": [
        "link_id",
        "revoked_at",
        "issuer",
        "key_version",
        "signature"
      ],
      "type": "object"
    },
    "SignedShareLink": {
      "additionalProperties": false,
      "description": "Signed share link authorizing a bounded grant (brief §12.a).",
      "properties": {
        "link_id": {
          "minLength": 1,
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ShareLinkPayload"
        },
        "signature": {
          "$ref": "../common/primitives.json#/$defs/Ed25519Signature"
        }
      },
      "required": [
        "link_id",
        "payload",
        "signature"
      ],
      "type": "object"
    }
  },
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/accept_share.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn verb: accept_share",
  "type": "object",
  "x-cairn-auth": "signed_chain",
  "x-cairn-capability": "cairn.mcp.v1.extension.federation",
  "x-cairn-cli": {
    "command": "accept-share",
    "flags": [
      {
        "cli_exemplar": "{\"kind\":\"propose\",\"issuer_key_id\":\"hmn:alice\"}",
        "long": "envelope",
        "name": "envelope",
        "value_source": "json"
      }
    ]
  },
  "x-cairn-contract": "cairn.mcp.v1",
  "x-cairn-extension": "cairn.federation.v1",
  "x-cairn-skill-triggers": {
    "exclusivity_hints": "this is the sole inbound share-acceptance surface; there is no other import path",
    "negative_triggers": [
      "do NOT use to propose a new share — that belongs to propose_share",
      "do NOT use to revoke a share — that belongs to revoke_share"
    ],
    "positive_triggers": [
      "use when the user receives an inbound federation envelope and wants to apply it locally",
      "use when the user says 'accept this share', 'apply this federation envelope', or 'import shared memories'"
    ]
  },
  "x-cairn-verb-id": "accept_share"
}
