{
  "$defs": {
    "Args": {
      "additionalProperties": false,
      "properties": {
        "fix": {
          "description": "When true, resolves live bitemporal edge contradictions by invalidating lower-confidence edges.",
          "type": "boolean",
          "x-cairn-auth": "write_capability"
        },
        "fix_skill_plan": {
          "description": "When true, writes reviewable Skillify repair plans instead of mutating live skills.",
          "type": "boolean",
          "x-cairn-auth": "write_capability"
        },
        "skill": {
          "description": "When true, runs Skillify bundle, resolver, gate, and rollback lint checks.",
          "type": "boolean"
        },
        "write_report": {
          "description": "When true, writes .cairn/lint-report.md.",
          "type": "boolean",
          "x-cairn-auth": "write_capability"
        }
      },
      "type": "object"
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "report_path": {
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "additionalProperties": false,
          "properties": {
            "auto_resolved": {
              "minimum": 0,
              "type": "integer"
            },
            "by_kind": {
              "additionalProperties": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            },
            "by_severity": {
              "additionalProperties": false,
              "properties": {
                "error": {
                  "minimum": 0,
                  "type": "integer"
                },
                "info": {
                  "minimum": 0,
                  "type": "integer"
                },
                "warning": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "error",
                "warning",
                "info"
              ],
              "type": "object"
            },
            "total": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "total",
            "by_severity",
            "by_kind"
          ],
          "type": "object"
        }
      },
      "required": [
        "summary",
        "findings"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggested_fix": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "tracking_issue": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "Kind": {
      "enum": [
        "broken_actor_chain",
        "broken_source_link",
        "contradictory_edge",
        "contradiction",
        "data_gap",
        "deferred_check",
        "ambiguous_edge",
        "hot_memory_over_budget",
        "index_drift",
        "malformed_record",
        "misclassified_profile",
        "missing_concept",
        "missing_provenance",
        "missing_summary",
        "orphan",
        "orphan_insight",
        "projection_drift",
        "projection_failed",
        "projection_hash_mismatch",
        "projection_missing",
        "projection_parser_failed",
        "projection_sidecar_unavailable",
        "projection_stale",
        "source_after_forget",
        "source_after_forget_unknown_version",
        "source_hash_mismatch",
        "source_link_dangling",
        "source_link_legacy_duplicate",
        "source_link_missing",
        "source_redact_skipped",
        "sensor_budget_exceeded",
        "sensor_privacy_denied",
        "skill_missing_artifact",
        "skill_unreachable",
        "skill_duplicate_lane",
        "skill_gate_failed",
        "skill_rollback_broken",
        "stale",
        "stale_profile_line",
        "stale_schema",
        "federation_dead_propagation",
        "workflow_dead_letter",
        "workflow_overdue",
        "workflow_stale_summary",
        "workflow_stuck",
        "wrong_class_for_kind"
      ],
      "type": "string"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "description": "At most one field SHOULD be set; consumers may treat multiple as the most-specific available.",
      "properties": {
        "operation_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "record_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/lint.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn verb: lint",
  "type": "object",
  "x-cairn-auth": "read_only",
  "x-cairn-capability": null,
  "x-cairn-cli": {
    "command": "lint",
    "flags": [
      {
        "long": "write-report",
        "name": "write_report",
        "value_source": "bool"
      },
      {
        "long": "fix",
        "name": "fix",
        "value_source": "bool"
      },
      {
        "long": "skill",
        "name": "skill",
        "value_source": "bool"
      },
      {
        "long": "fix-skill-plan",
        "name": "fix_skill_plan",
        "value_source": "bool"
      }
    ]
  },
  "x-cairn-contract": "cairn.mcp.v1",
  "x-cairn-skill-triggers": {
    "exclusivity_hints": "this is the canonical vault-health surface",
    "negative_triggers": [
      "do NOT call per turn — run on a cadence (daily / on PR)"
    ],
    "positive_triggers": [
      "use to check vault health — contradictions, orphans, stale claims, missing concept pages, malformed records, broken actor chains, schema drift, hot-memory budget, derived-index drift"
    ]
  },
  "x-cairn-verb-id": "lint"
}
