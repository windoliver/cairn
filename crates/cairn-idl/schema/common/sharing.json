{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/common/sharing.json",
  "title": "Cairn federation sharing types",
  "x-cairn-contract": "cairn.mcp.v1",
  "description": "Canonical definitions for share-link and revocation wire types used by propose_share, accept_share, and revoke_share verbs (brief §12.a). Keeping these in one place ensures the issuer and receiver operate on identical structures.",
  "$defs": {
    "ScopeTuple": {
      "type": "object",
      "additionalProperties": false,
      "description": "Seven-dimensional scope tuple (brief §6). At least one field must be set.",
      "properties": {
        "tenant":     { "type": "string", "minLength": 1 },
        "workspace":  { "type": "string", "minLength": 1 },
        "project":    { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "entity":     { "type": "string", "minLength": 1 },
        "user":       { "type": "string", "minLength": 1 },
        "agent":      { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["tenant"] },
        { "required": ["workspace"] },
        { "required": ["project"] },
        { "required": ["session_id"] },
        { "required": ["entity"] },
        { "required": ["user"] },
        { "required": ["agent"] }
      ]
    },
    "ShareLinkPayload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Body-free payload for a signed share-link grant (brief §12.a). Matches domain::sharing::ShareLinkPayload.",
      "required": ["operation_id", "nonce", "target_hash", "target_id_hashes", "scope", "grant_tier", "issuer", "issued_at", "expires_at", "key_version"],
      "properties": {
        "operation_id":      { "$ref": "./primitives.json#/$defs/Ulid" },
        "nonce":             { "$ref": "./primitives.json#/$defs/Nonce16Base64" },
        "target_hash":       { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "target_id_hashes":  { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
        "scope":             { "$ref": "#/$defs/ScopeTuple" },
        "grant_tier":        { "type": "string", "enum": ["session", "project", "team", "org", "public"] },
        "grantee":           { "$ref": "./primitives.json#/$defs/Identity" },
        "issuer":            { "$ref": "./primitives.json#/$defs/Identity" },
        "issued_at":         { "type": "string", "format": "date-time", "minLength": 20 },
        "expires_at":        { "type": "string", "format": "date-time", "minLength": 20 },
        "key_version":       { "type": "integer", "minimum": 1 }
      }
    },
    "SignedShareLink": {
      "type": "object",
      "additionalProperties": false,
      "description": "Signed share link authorizing a bounded grant (brief §12.a). Matches domain::sharing::SignedShareLink.",
      "required": ["link_id", "payload", "signature"],
      "properties": {
        "link_id":   { "type": "string", "minLength": 1 },
        "payload":   { "$ref": "#/$defs/ShareLinkPayload" },
        "signature": { "$ref": "./primitives.json#/$defs/Ed25519Signature" }
      }
    },
    "SignedRevocation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Signed revocation record cancelling a previously issued share link (brief §12.a).",
      "required": ["link_id", "revoked_at", "issuer", "key_version", "signature"],
      "properties": {
        "link_id":     { "type": "string", "minLength": 1 },
        "revoked_at":  { "type": "string", "format": "date-time", "minLength": 20 },
        "issuer":      { "$ref": "./primitives.json#/$defs/Identity" },
        "key_version": { "type": "integer", "minimum": 1 },
        "signature":   { "$ref": "./primitives.json#/$defs/Ed25519Signature" }
      }
    }
  }
}
