---
source: crates/cairn-idl/tests/wire_compat_v1.rs
expression: body
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/forget.json",
  "title": "Cairn verb: forget",
  "x-cairn-contract": "cairn.mcp.v1",
  "x-cairn-verb-id": "forget",
  "x-cairn-capability": null,
  "x-cairn-auth": "forget_capability",
  "x-cairn-cli": {
    "command": "forget",
    "note": "top-level CLI shape; per-mode flags are defined on each $defs.Args* sub-type"
  },
  "x-cairn-skill-triggers": {
    "positive_triggers": [
      "use when the user asks to delete or forget a specific record / session / scope",
      "use as part of a compliance-driven forget-me flow"
    ],
    "negative_triggers": [
      "do NOT use to 'mark as resolved' — that belongs to an ingest with kind:feedback",
      "do NOT use on a draft the user wants to edit — that belongs to ingest with version bump"
    ],
    "exclusivity_hints": "this is the single delete surface — there is no other delete path"
  },
  "type": "object",
  "$defs": {
    "Args": {
      "x-cairn-discriminator": "mode",
      "oneOf": [
        { "$ref": "#/$defs/ArgsRecord" },
        { "$ref": "#/$defs/ArgsSession" },
        { "$ref": "#/$defs/ArgsScope" }
      ]
    },
    "ArgsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "record_id"],
      "x-cairn-capability": "cairn.mcp.v1.forget.record",
      "x-cairn-since": "v0.1",
      "x-cairn-cli": {
        "command": "forget",
        "flags": [
          { "name": "record_id", "long": "record", "value_source": "string" }
        ]
      },
      "properties": {
        "mode":      { "const": "record" },
        "record_id": { "$ref": "../common/primitives.json#/$defs/Ulid" },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "description": "If true, produce a FlushPlan and emit it without writing to MemoryStore (brief §5.5). Mutually exclusive with human_review."
        },
        "human_review": {
          "type": "boolean",
          "default": false,
          "description": "If true, persist a FlushPlan under .cairn/flush/pending/ for explicit `cairn flush apply` (brief §5.5). Mutually exclusive with dry_run."
        },
        "no_diff": {
          "type": "boolean",
          "default": false,
          "description": "When human_review=true, skip emitting the markdown diff sidecar."
        }
      }
    },
    "ArgsSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "session_id"],
      "x-cairn-capability": "cairn.mcp.v1.forget.session",
      "x-cairn-since": "v0.2",
      "x-cairn-cli": {
        "command": "forget",
        "flags": [
          { "name": "session_id", "long": "session", "value_source": "string" }
        ]
      },
      "properties": {
        "mode":       { "const": "session" },
        "session_id": { "type": "string", "minLength": 1 },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "description": "If true, produce a FlushPlan and emit it without writing to MemoryStore (brief §5.5). Mutually exclusive with human_review."
        },
        "human_review": {
          "type": "boolean",
          "default": false,
          "description": "If true, persist a FlushPlan under .cairn/flush/pending/ for explicit `cairn flush apply` (brief §5.5). Mutually exclusive with dry_run."
        },
        "no_diff": {
          "type": "boolean",
          "default": false,
          "description": "When human_review=true, skip emitting the markdown diff sidecar."
        }
      }
    },
    "ArgsScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scope"],
      "x-cairn-capability": "cairn.mcp.v1.forget.scope",
      "x-cairn-since": "v0.3",
      "x-cairn-cli": {
        "command": "forget",
        "flags": [
          { "name": "scope", "long": "scope", "value_source": "json", "cli_exemplar": "{\"user\":\"u\"}" }
        ]
      },
      "properties": {
        "mode":  { "const": "scope" },
        "scope": { "$ref": "../common/scope_filter.json" },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "description": "If true, produce a FlushPlan and emit it without writing to MemoryStore (brief §5.5). Mutually exclusive with human_review."
        },
        "human_review": {
          "type": "boolean",
          "default": false,
          "description": "If true, persist a FlushPlan under .cairn/flush/pending/ for explicit `cairn flush apply` (brief §5.5). Mutually exclusive with dry_run."
        },
        "no_diff": {
          "type": "boolean",
          "default": false,
          "description": "When human_review=true, skip emitting the markdown diff sidecar."
        }
      }
    },
    "Data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deleted_count"],
      "properties": {
        "deleted_count": { "type": "integer", "minimum": 0 },
        "tombstones":    { "type": "array", "items": { "$ref": "../common/primitives.json#/$defs/Ulid" } },
        "plan_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Path under .cairn/flush/pending/ when human_review=true; absent otherwise."
        }
      }
    }
  }
}
