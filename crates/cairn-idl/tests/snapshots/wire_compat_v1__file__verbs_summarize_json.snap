---
source: crates/cairn-idl/tests/wire_compat_v1.rs
expression: body
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/summarize.json",
  "title": "Cairn verb: summarize",
  "x-cairn-contract": "cairn.mcp.v1",
  "x-cairn-verb-id": "summarize",
  "x-cairn-capability": null,
  "x-cairn-auth": "rebac",
  "x-cairn-cli": {
    "command": "summarize",
    "positional": { "name": "record_ids", "description": "One or more record ULIDs.", "repeatable": true },
    "flags": [
      { "name": "persist",   "long": "persist",   "value_source": "bool" },
      { "name": "kind",      "long": "kind",      "value_source": "string" },
      { "name": "citations", "long": "citations", "value_source": "enum(on,compact,off)" }
    ]
  },
  "x-cairn-skill-triggers": {
    "positive_triggers": [
      "use to roll up a list of known record ids into a single synthesis"
    ],
    "negative_triggers": [
      "do NOT use to answer a general question — call search first"
    ],
    "exclusivity_hints": "this is the canonical summarize surface"
  },
  "type": "object",
  "$defs": {
    "Args": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_ids"],
      "properties": {
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common/primitives.json#/$defs/Ulid" }
        },
        "persist": {
          "type": "boolean",
          "x-cairn-auth": "write_capability",
          "description": "When true, files the synthesis as a new reference or strategy_success memory."
        },
        "kind":      { "type": "string", "minLength": 1, "description": "Kind to file under if persist is true." },
        "citations": { "type": "string", "enum": ["on", "compact", "off"] }
      }
    },
    "Data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "facts", "concepts", "narrative"],
      "properties": {
        "digest":             { "type": "string", "minLength": 1, "description": "Short title-style summary for human-readable lists." },
        "facts":              { "type": "array", "items": { "$ref": "#/$defs/SummaryFact" } },
        "concepts":           { "type": "array", "items": { "$ref": "#/$defs/SummaryConcept" } },
        "narrative":          { "type": "string", "description": "Free-form prose narrative. Empty when no LLM-backed narrative is available." },
        "persisted_record_id":{ "$ref": "../common/primitives.json#/$defs/Ulid", "description": "Present when persist was true." }
      }
    },
    "SummaryFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object", "confidence", "source_record_ids"],
      "properties": {
        "subject":           { "type": "string", "minLength": 1, "description": "Entity name or pronoun resolution." },
        "predicate":         { "type": "string", "minLength": 1 },
        "object":            { "type": "string", "minLength": 1 },
        "confidence":        { "$ref": "#/$defs/ConfidenceTag" },
        "source_record_ids": { "type": "array", "items": { "$ref": "../common/primitives.json#/$defs/Ulid" } }
      }
    },
    "SummaryConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "salience"],
      "properties": {
        "name":     { "type": "string", "minLength": 1 },
        "kind":     { "$ref": "#/$defs/ConceptKind" },
        "salience": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ConfidenceTag": {
      "type": "string",
      "enum": ["extracted", "inferred", "ambiguous"]
    },
    "ConceptKind": {
      "type": "string",
      "enum": ["entity", "topic", "decision", "constraint"]
    }
  }
}
