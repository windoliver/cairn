{
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/prelude/status.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "aggregate extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.aggregate.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.aggregate"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.aggregate"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.aggregate.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    },
    {
      "$comment": "admin extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.admin.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.admin"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.admin"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.admin.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    },
    {
      "$comment": "federation extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.federation.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.federation"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.federation"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.federation.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    },
    {
      "$comment": "sessiontree extension ↔ capability binding",
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.sessiontree.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.sessiontree"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "cairn.mcp.v1.extension.sessiontree"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "name": {
                  "const": "cairn.sessiontree.v1"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      }
    }
  ],
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "../capabilities/capabilities.json"
      },
      "type": "array",
      "uniqueItems": true
    },
    "contract": {
      "const": "cairn.mcp.v1"
    },
    "extensions": {
      "items": {
        "$ref": "../extensions/registry.json#/$defs/namespace"
      },
      "type": "array",
      "uniqueItems": true
    },
    "health": {
      "additionalProperties": false,
      "properties": {
        "authority_db": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "state": {
              "enum": [
                "healthy",
                "missing",
                "unavailable"
              ],
              "type": "string"
            }
          },
          "required": [
            "state",
            "path"
          ],
          "type": "object"
        },
        "nexus_projection": {
          "additionalProperties": false,
          "properties": {
            "data_dir": {
              "minLength": 1,
              "type": "string"
            },
            "endpoint": {
              "minLength": 1,
              "type": "string"
            },
            "projection_detail": {
              "additionalProperties": false,
              "properties": {
                "last_successful_rebuild_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "targets": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "current": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "failed": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "lagging": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "reason": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "state": {
                        "enum": [
                          "current",
                          "stale",
                          "failed",
                          "missing"
                        ],
                        "type": "string"
                      },
                      "target": {
                        "enum": [
                          "bm25s",
                          "parser_pdf_text",
                          "parser_docx_text",
                          "parser_video_frame_text",
                          "parser_vision_caption"
                        ],
                        "type": "string"
                      },
                      "total": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "target",
                      "state",
                      "total",
                      "current",
                      "lagging",
                      "failed"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "required": [
                "targets"
              ],
              "type": "object"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "state": {
              "enum": [
                "disabled",
                "healthy",
                "degraded"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      },
      "required": [
        "authority_db",
        "nexus_projection"
      ],
      "type": "object"
    },
    "server_info": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "minLength": 1,
          "type": "string"
        },
        "incarnation": {
          "allOf": [
            {
              "$ref": "../common/primitives.json#/$defs/Ulid"
            }
          ],
          "description": "ULID minted at daemon start."
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "build",
        "started_at",
        "incarnation"
      ],
      "type": "object"
    }
  },
  "required": [
    "contract",
    "server_info",
    "capabilities",
    "extensions",
    "health"
  ],
  "title": "Cairn status response",
  "type": "object",
  "x-cairn-contract": "cairn.mcp.v1"
}
