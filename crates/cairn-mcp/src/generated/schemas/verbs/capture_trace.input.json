{
  "$defs": {
    "Args": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "from"
          ]
        },
        {
          "required": [
            "blocks",
            "session_id"
          ]
        }
      ],
      "properties": {
        "blocks": {
          "description": "Path to a JSON file containing a Vec<TraceBlock>. Accepts optional @path syntax.",
          "minLength": 1,
          "type": "string"
        },
        "from": {
          "description": "Path to the trace log or transcript file.",
          "minLength": 1,
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "failed_turns": {
          "description": "Per-turn failures that were skipped while other turns in the trace import committed.",
          "items": {
            "$ref": "#/$defs/FailedTurn"
          },
          "type": "array"
        },
        "trace_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        }
      },
      "required": [
        "trace_id",
        "failed_turns"
      ],
      "type": "object"
    },
    "FailedTurn": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "turn_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "turn_id",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/capture_trace.input.json",
  "$ref": "#/$defs/Args",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn verb input: capture_trace",
  "x-cairn-contract": "cairn.mcp.v1"
}
