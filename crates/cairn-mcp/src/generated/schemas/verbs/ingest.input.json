{
  "$defs": {
    "Args": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "body"
          ]
        },
        {
          "required": [
            "file"
          ]
        },
        {
          "required": [
            "folder"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "batch_size": {
          "default": 64,
          "description": "Maximum cache-miss files per FlushPlan batch.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "body": {
          "minLength": 1,
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "description": "If true, produce a FlushPlan and emit it without writing to MemoryStore (brief §5.5). Mutually exclusive with human_review.",
          "type": "boolean"
        },
        "exclude": {
          "description": "Exclude glob patterns for folder ingest.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "file": {
          "description": "Path on the local filesystem.",
          "minLength": 1,
          "type": "string"
        },
        "folder": {
          "description": "Folder path to ingest recursively with the extraction cache.",
          "minLength": 1,
          "type": "string"
        },
        "frontmatter": {
          "description": "Extra YAML frontmatter fields to store alongside the body.",
          "type": "object"
        },
        "human_review": {
          "default": false,
          "description": "If true, persist a FlushPlan under .cairn/flush/pending/ for explicit `cairn flush apply` (brief §5.5). Mutually exclusive with dry_run.",
          "type": "boolean"
        },
        "include": {
          "description": "Include glob patterns for folder ingest.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "description": "Memory taxonomy kind (19 possible values — see §3 taxonomy). Validated beyond JSON Schema by the classifier.",
          "minLength": 1,
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/IngestMode",
          "default": "keyword",
          "description": "Folder ingest extraction mode.",
          "oneOf": [
            {
              "const": "keyword"
            },
            {
              "const": "semantic"
            },
            {
              "const": "full"
            }
          ]
        },
        "no_cache": {
          "description": "Bypass extraction cache lookup for folder ingest, but still write refreshed cache entries.",
          "type": "boolean"
        },
        "no_diff": {
          "default": false,
          "description": "When human_review=true, skip emitting the markdown diff sidecar.",
          "type": "boolean"
        },
        "recursive": {
          "default": true,
          "description": "Whether folder ingest recurses into child directories. CLI default: true.",
          "type": "boolean"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "cache_hits": {
          "description": "Folder ingest cache hits.",
          "minimum": 0,
          "type": "integer"
        },
        "cache_misses": {
          "description": "Folder ingest cache misses or forced re-extractions.",
          "minimum": 0,
          "type": "integer"
        },
        "cache_writes": {
          "description": "Folder ingest cache entries written.",
          "minimum": 0,
          "type": "integer"
        },
        "files_processed": {
          "description": "Folder ingest file count when source is --folder.",
          "minimum": 0,
          "type": "integer"
        },
        "plan_ref": {
          "description": "Path under .cairn/flush/pending/ when human_review=true; absent otherwise.",
          "minLength": 1,
          "type": "string"
        },
        "record_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid",
          "description": "ULID of the newly stored record."
        },
        "session_id": {
          "description": "Resolved session (created if absent — see §8.1).",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "session_id"
      ],
      "type": "object"
    },
    "IngestMode": {
      "enum": [
        "keyword",
        "semantic",
        "full"
      ],
      "type": "string"
    }
  },
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/ingest.input.json",
  "$ref": "#/$defs/Args",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn verb input: ingest",
  "x-cairn-contract": "cairn.mcp.v1"
}
