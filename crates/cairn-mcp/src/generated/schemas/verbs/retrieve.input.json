{
  "$defs": {
    "Args": {
      "oneOf": [
        {
          "$ref": "#/$defs/ArgsRecord"
        },
        {
          "$ref": "#/$defs/ArgsSession"
        },
        {
          "$ref": "#/$defs/ArgsTurn"
        },
        {
          "$ref": "#/$defs/ArgsFolder"
        },
        {
          "$ref": "#/$defs/ArgsScope"
        },
        {
          "$ref": "#/$defs/ArgsProfile"
        }
      ],
      "x-cairn-discriminator": "target"
    },
    "ArgsFolder": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "maximum": 16,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "const": "folder"
        }
      },
      "required": [
        "target",
        "path"
      ],
      "type": "object",
      "x-cairn-capability": "cairn.mcp.v1.retrieve.folder",
      "x-cairn-cli": {
        "command": "retrieve",
        "flags": [
          {
            "long": "folder",
            "name": "path",
            "value_source": "string"
          },
          {
            "long": "depth",
            "name": "depth",
            "value_source": "u8"
          }
        ]
      }
    },
    "ArgsProfile": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "user"
          ]
        },
        {
          "required": [
            "agent"
          ]
        }
      ],
      "properties": {
        "agent": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "const": "profile"
        },
        "user": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "type": "object",
      "x-cairn-capability": "cairn.mcp.v1.retrieve.profile",
      "x-cairn-cli": {
        "command": "retrieve",
        "flags": [
          {
            "long": "profile",
            "name": "profile",
            "value_source": "bool"
          },
          {
            "long": "user",
            "name": "user",
            "value_source": "string"
          },
          {
            "long": "agent",
            "name": "agent",
            "value_source": "string"
          }
        ]
      }
    },
    "ArgsRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        },
        "target": {
          "const": "record"
        }
      },
      "required": [
        "target",
        "id"
      ],
      "type": "object",
      "x-cairn-capability": "cairn.mcp.v1.retrieve.record",
      "x-cairn-cli": {
        "command": "retrieve",
        "positional": {
          "description": "Record ULID",
          "name": "id"
        }
      }
    },
    "ArgsScope": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "Opaque continuation token from a prior DataScope.next_cursor.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "$ref": "../common/scope_filter.json"
        },
        "target": {
          "const": "scope"
        }
      },
      "required": [
        "target",
        "scope"
      ],
      "type": "object",
      "x-cairn-capability": "cairn.mcp.v1.retrieve.scope",
      "x-cairn-cli": {
        "command": "retrieve",
        "flags": [
          {
            "cli_exemplar": "{\"user\":\"u\"}",
            "long": "scope",
            "name": "scope",
            "value_source": "json"
          },
          {
            "long": "cursor",
            "name": "cursor",
            "value_source": "string"
          }
        ]
      }
    },
    "ArgsSession": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "$ref": "../common/primitives.json#/$defs/Cursor",
          "description": "Opaque continuation token from a prior DataSession.next_cursor."
        },
        "include": {
          "items": {
            "enum": [
              "tool_calls",
              "reasoning"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "include_reasoning": {
          "description": "Sugar for requesting reasoning blocks in the retrieved session transcript.",
          "type": "boolean"
        },
        "limit": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "order": {
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string"
        },
        "rehydrate": {
          "type": "boolean"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "const": "session"
        }
      },
      "required": [
        "target",
        "session_id"
      ],
      "type": "object",
      "x-cairn-capability": "cairn.mcp.v1.retrieve.session",
      "x-cairn-cli": {
        "command": "retrieve",
        "flags": [
          {
            "long": "session",
            "name": "session_id",
            "value_source": "string"
          },
          {
            "long": "limit",
            "name": "limit",
            "value_source": "u32"
          },
          {
            "long": "order",
            "name": "order",
            "value_source": "enum(asc,desc)"
          },
          {
            "long": "rehydrate",
            "name": "rehydrate",
            "value_source": "bool"
          },
          {
            "long": "include-reasoning",
            "name": "include_reasoning",
            "value_source": "bool"
          },
          {
            "long": "include",
            "name": "include",
            "value_source": "list<enum(tool_calls,reasoning)>"
          },
          {
            "long": "cursor",
            "name": "cursor",
            "value_source": "string"
          }
        ]
      }
    },
    "ArgsTurn": {
      "additionalProperties": false,
      "properties": {
        "include": {
          "items": {
            "enum": [
              "tool_calls",
              "reasoning"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "include_reasoning": {
          "description": "Sugar for requesting reasoning blocks in the retrieved turn.",
          "type": "boolean"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "const": "turn"
        },
        "turn_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "target",
        "session_id",
        "turn_id"
      ],
      "type": "object",
      "x-cairn-capability": "cairn.mcp.v1.retrieve.turn",
      "x-cairn-cli": {
        "command": "retrieve",
        "flags": [
          {
            "long": "session",
            "name": "session_id",
            "value_source": "string"
          },
          {
            "long": "turn",
            "name": "turn_id",
            "value_source": "string"
          },
          {
            "long": "include-reasoning",
            "name": "include_reasoning",
            "value_source": "bool"
          },
          {
            "long": "include",
            "name": "include",
            "value_source": "list<enum(tool_calls,reasoning)>"
          }
        ]
      }
    },
    "Data": {
      "description": "Shape depends on the matched Args target. The response envelope echoes target so validators can bind Data to the exact branch. Each branch requires its target metadata so a session response can never be mistaken for a folder response even outside the envelope.",
      "oneOf": [
        {
          "$ref": "#/$defs/DataRecord"
        },
        {
          "$ref": "#/$defs/DataProfile"
        },
        {
          "$ref": "#/$defs/DataSession"
        },
        {
          "$ref": "#/$defs/DataTurn"
        },
        {
          "$ref": "#/$defs/DataFolder"
        },
        {
          "$ref": "#/$defs/DataScope"
        }
      ]
    },
    "DataFolder": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "maximum": 16,
          "minimum": 0,
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "type": "array"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "items"
      ],
      "type": "object"
    },
    "DataProfile": {
      "additionalProperties": false,
      "description": "Typed AutoUserProfile (brief §7.1) split into permanent traits (`static`, `is_static = 1`) and current state (`dynamic`, `is_static = 0`). Each half carries `summary`, `historical_summary`, and structured `key_facts`; every fact line records its source-record evidence so record-level forget propagates back to the profile. P0 plain-SQLite aggregation; richer rolling-summary regeneration is P1. Wire field names match the brief's `{static, dynamic, updated_at}` notation; the Rust binding emits them via the `r#static` raw identifier.",
      "properties": {
        "dynamic": {
          "$ref": "#/$defs/ProfileHalf"
        },
        "static": {
          "$ref": "#/$defs/ProfileHalf"
        },
        "subject": {
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "user"
              ]
            },
            {
              "required": [
                "agent"
              ]
            }
          ],
          "properties": {
            "agent": {
              "minLength": 1,
              "type": "string"
            },
            "user": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "updated_at": {
          "description": "RFC3339 timestamp of the most recent contributing source record. Equals the synthesizer clock when the profile is empty. Validator accept set matches `cairn_core::domain::Rfc3339Timestamp::parse` (excluding leap-seconds), so any wire-accepted value also parses domain-side without a second gauntlet.",
          "format": "date-time",
          "maxLength": 64,
          "minLength": 20,
          "type": "string"
        }
      },
      "required": [
        "subject",
        "static",
        "dynamic",
        "updated_at"
      ],
      "type": "object"
    },
    "DataRecord": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "frontmatter": {
          "type": "object"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "record_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        }
      },
      "required": [
        "record_id",
        "kind"
      ],
      "type": "object"
    },
    "DataScope": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/RecordRef"
          },
          "type": "array"
        },
        "next_cursor": {
          "$ref": "../common/primitives.json#/$defs/Cursor"
        },
        "scope": {
          "$ref": "../common/scope_filter.json"
        }
      },
      "required": [
        "scope",
        "items"
      ],
      "type": "object"
    },
    "DataSession": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/TurnItem"
          },
          "type": "array"
        },
        "next_cursor": {
          "$ref": "../common/primitives.json#/$defs/Cursor"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "items"
      ],
      "type": "object"
    },
    "DataTurn": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "turn": {
          "description": "Ordered TurnItems for the turn — one per trace event (user/agent message, pre/post tool, tool output, stop, summary). Sorted by (captured_at, capture_event_id).",
          "items": {
            "$ref": "#/$defs/TurnItem"
          },
          "type": "array"
        },
        "turn_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "turn_id",
        "turn"
      ],
      "type": "object"
    },
    "KeyFacts": {
      "additionalProperties": false,
      "description": "Seven structured fact buckets (brief §7.1). Each bucket is an array of ProfileLine — empty arrays are valid and required so a consumer can rely on every key being present.",
      "properties": {
        "addressed_issues": {
          "items": {
            "$ref": "#/$defs/ProfileLine"
          },
          "type": "array"
        },
        "current_issues": {
          "items": {
            "$ref": "#/$defs/ProfileLine"
          },
          "type": "array"
        },
        "devices": {
          "items": {
            "$ref": "#/$defs/ProfileLine"
          },
          "type": "array"
        },
        "known_entities": {
          "items": {
            "$ref": "#/$defs/ProfileLine"
          },
          "type": "array"
        },
        "preferences": {
          "items": {
            "$ref": "#/$defs/ProfileLine"
          },
          "type": "array"
        },
        "recurring_issues": {
          "items": {
            "$ref": "#/$defs/ProfileLine"
          },
          "type": "array"
        },
        "software": {
          "items": {
            "$ref": "#/$defs/ProfileLine"
          },
          "type": "array"
        }
      },
      "required": [
        "devices",
        "software",
        "preferences",
        "current_issues",
        "addressed_issues",
        "recurring_issues",
        "known_entities"
      ],
      "type": "object"
    },
    "ProfileHalf": {
      "additionalProperties": false,
      "description": "One half of an AutoUserProfile (brief §7.1). `summary` and `historical_summary` are the rolling DreamWorkflow narratives — they remain empty strings at P0 and are populated by the P1 ConsolidationWorkflow. `key_facts` is the P0 deliverable: structured per-facet ProfileLine arrays.",
      "properties": {
        "historical_summary": {
          "type": "string"
        },
        "key_facts": {
          "$ref": "#/$defs/KeyFacts"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary",
        "historical_summary",
        "key_facts"
      ],
      "type": "object"
    },
    "ProfileLine": {
      "additionalProperties": false,
      "description": "One profile fact with its evidence trail. `evidence` is the list of source records that contributed; record-level forget removes them from the input set, so re-synthesizing the profile drops the line.",
      "properties": {
        "confidence": {
          "description": "Confidence in [0, 1]. Records with confidence < 0.3 (ConfidenceBand::Uncertain) are excluded from the profile.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "evidence": {
          "description": "Source-record ULIDs whose bodies contributed to this line. Always non-empty.",
          "items": {
            "$ref": "../common/primitives.json#/$defs/Ulid"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "value": {
          "description": "Canonical short statement of the fact (e.g., 'prefers terse explanations', 'M2 MacBook Pro').",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value",
        "confidence",
        "evidence"
      ],
      "type": "object"
    },
    "RecordRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "record_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid"
        },
        "snippet": {
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind"
      ],
      "type": "object"
    },
    "TurnItem": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ],
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "turn_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "role"
      ],
      "type": "object"
    }
  },
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/retrieve.input.json",
  "$ref": "#/$defs/Args",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn verb input: retrieve",
  "x-cairn-contract": "cairn.mcp.v1"
}
