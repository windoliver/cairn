{
  "$defs": {
    "Args": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "enum": [
            "on",
            "compact",
            "off"
          ],
          "type": "string"
        },
        "kind": {
          "description": "Kind to file under if persist is true.",
          "minLength": 1,
          "type": "string"
        },
        "persist": {
          "description": "When true, files the synthesis as a new reference or strategy_success memory.",
          "type": "boolean",
          "x-cairn-auth": "write_capability"
        },
        "record_ids": {
          "items": {
            "$ref": "../common/primitives.json#/$defs/Ulid"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "record_ids"
      ],
      "type": "object"
    },
    "ConceptKind": {
      "enum": [
        "entity",
        "topic",
        "decision",
        "constraint"
      ],
      "type": "string"
    },
    "ConfidenceTag": {
      "enum": [
        "extracted",
        "inferred",
        "ambiguous"
      ],
      "type": "string"
    },
    "Data": {
      "additionalProperties": false,
      "properties": {
        "concepts": {
          "items": {
            "$ref": "#/$defs/SummaryConcept"
          },
          "type": "array"
        },
        "digest": {
          "description": "Short title-style summary for human-readable lists.",
          "minLength": 1,
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/SummaryFact"
          },
          "type": "array"
        },
        "narrative": {
          "description": "Free-form prose narrative. Empty when no LLM-backed narrative is available.",
          "type": "string"
        },
        "persisted_record_id": {
          "$ref": "../common/primitives.json#/$defs/Ulid",
          "description": "Present when persist was true."
        }
      },
      "required": [
        "digest",
        "facts",
        "concepts",
        "narrative"
      ],
      "type": "object"
    },
    "SummaryConcept": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConceptKind"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "salience": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "name",
        "kind",
        "salience"
      ],
      "type": "object"
    },
    "SummaryFact": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ConfidenceTag"
        },
        "object": {
          "minLength": 1,
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "type": "string"
        },
        "source_record_ids": {
          "items": {
            "$ref": "../common/primitives.json#/$defs/Ulid"
          },
          "type": "array"
        },
        "subject": {
          "description": "Entity name or pronoun resolution.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "subject",
        "predicate",
        "object",
        "confidence",
        "source_record_ids"
      ],
      "type": "object"
    }
  },
  "$id": "https://cairn.dev/schema/cairn.mcp.v1/verbs/summarize.input.json",
  "$ref": "#/$defs/Args",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn verb input: summarize",
  "x-cairn-contract": "cairn.mcp.v1"
}
