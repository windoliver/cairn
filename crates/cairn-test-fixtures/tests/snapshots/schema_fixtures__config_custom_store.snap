    }
  },
  "consolidation": {
    "enabled": true,
    "window_size_turns": 8,
    "min_turns_for_trigger": 4,
    "token_budget": 512,
    "salience_floor": 0.4
  },
  "dream": {
    "enabled": false,
    "light_sleep": {
      "tier": "light_sleep",
      "cadence": "stop_hook_and_turns",
