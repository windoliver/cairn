name: verify-cairn-pack

on:
  pull_request:
  push:
    branches: [main]

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install Cairn
        run: cargo install --git https://github.com/windoliver/cairn --locked --bin cairn cairn-cli
      - name: Verify pack
        run: cairn plugins verify --pack-path . --strict
      - name: Smoke test
        run: bash tests/smoke.sh
