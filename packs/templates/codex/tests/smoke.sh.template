#!/usr/bin/env bash
set -euo pipefail

if [ -f "pack.json" ] && [ -f "agents/{{subagent_id}}.md" ]; then
  test -f "{{manual_fragment}}"
  test -f "commands/{{command_id}}.md"
  test -f "hooks/hooks.json"
  grep -q "{{pack_id}}" "{{manual_fragment}}"
  exit 0
fi

test -f ".codex/agents/{{subagent_id}}.md"
test -f ".codex/commands/{{command_id}}.md"
test -f ".codex/hooks.json"
test -f "AGENTS.md"
grep -q "{{pack_id}}" "AGENTS.md"
